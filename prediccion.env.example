# ============================================================================
# Predicción (MiroFish) — variables del sidecar
# Copiar a `prediccion.env` junto al docker-compose del harness y rellenar.
# NO subir al repo: contiene claves de API.
# ============================================================================

# Modelo principal: estructura, ontología, personas, informe.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat

# Grafo de memoria. Sin esta clave el backend no arranca.
ZEP_API_KEY=

# Opcional: modelo barato para las miles de acciones de los agentes OASIS.
# Dejar comentado si no se usa (la doc de MiroFish pide que no existan vacías).
# LLM_BOOST_API_KEY=
# LLM_BOOST_BASE_URL=
# LLM_BOOST_MODEL_NAME=

# Rondas por defecto de una simulación. Cada ronda multiplica el coste.
OASIS_DEFAULT_MAX_ROUNDS=40
