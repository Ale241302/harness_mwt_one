# Copia externa de los respaldos de la Mesa en un buzón IMAP.
#
# Se instala en el host como /etc/mwt/mesa-offsite.env con modo 600 y dueño root;
# `backup-mesa.sh` y `restore-mesa-drill.sh` lo leen sin ejecutarlo y sin pisar
# las variables que ya estén en el entorno. Este archivo del repositorio no lleva
# credenciales: son las de la cuenta de correo que guarda las copias.
#
#   install -d -m 700 /etc/mwt
#   install -m 600 scripts/mesa-offsite.env.example /etc/mwt/mesa-offsite.env
#   $EDITOR /etc/mwt/mesa-offsite.env

# Enciende la copia externa en `backup-mesa.sh` (cualquier otro valor la apaga).
MESA_OFFSITE=on

MESA_OFFSITE_HOST=imap.hostinger.com
MESA_OFFSITE_PORT=993
MESA_OFFSITE_USER=alejandro@muitowork.com
MESA_OFFSITE_PASS=cambia-esta-clave

# Carpeta del buzón. Vacío = `INBOX<separador>Mesa-Backups`, creada si falta.
# MESA_OFFSITE_FOLDER=

# Retención del buzón: ventana con todas las copias, un diario hasta 30 días,
# tope duro y mínimo intocable. Un dump pesa ~280 kB y la cuota es de 50 GB.
MESA_OFFSITE_KEEP_HOURS=72
MESA_OFFSITE_KEEP_DAYS=30
MESA_OFFSITE_KEEP_MAX=200
MESA_OFFSITE_KEEP_MIN=3
MESA_OFFSITE_MAX_MB=20

# Cifrado del adjunto con age. Con un destinatario, el buzón guarda
# `<dump>.age` y el asunto lleva `plain_sha256=` y `enc=age`: leer el correo ya
# no basta para leer la base. La identidad descifra; guarda una copia fuera del
# VPS (es la que permite restaurar si se pierde el host).
# MESA_OFFSITE_AGE_RECIPIENT=age1...
# MESA_OFFSITE_AGE_IDENTITY=/etc/mwt/mesa-age.key
