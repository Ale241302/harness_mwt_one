# ── Harness MWT · variables de entorno ────────────────────────────────
# Copia este archivo a .env y rellena los valores. NO subir .env al repo.

# Secreto para firmar la cookie de sesión del gateway (obligatorio).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# API de la consola MWT.ONE (donde vive /api/auth/login/).
CONSOLA_API_BASE=https://consola.mwt.one/api

# Host público que ve el proxy (debe coincidir con el trusted-host de dsh).
PUBLIC_HOST=harness.mwt.one

# Clave del modelo DeepSeek que usará el harness.
DEEPSEEK_API_KEY=

# ── MCP de la consola ─────────────────────────────────────────────────
MWT_MCP_URL=http://consola-mwt-one-mcp:8765/mcp
# Secreto compartido gateway→MCP (MWT_MCP_GATEWAY_KEY del stack consola).
MWT_MCP_GATEWAY_KEY=
# Opcional: cliente/tenant por defecto (UUID de clientes.cliente.id).
MWT_MCP_CLIENT_ID=

# ── Runner de dsh ─────────────────────────────────────────────────────
DATA_DIR=/data/users
DSH_BASE_PORT=3100
DSH_BIN=dsh

# ── Límites por instancia dsh (E1) ────────────────────────────────────
# Cap de heap de Node por usuario (MB); evita que uno agote la RAM.
DSH_MAX_OLD_SPACE_MB=1024
# Descriptores de archivo por proceso.
DSH_NOFILE_LIMIT=8192
# Segundos de CPU por proceso; 0 = sin límite (recomendado para agentes largos).
DSH_CPU_LIMIT_S=0
