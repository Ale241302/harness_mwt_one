# ── Harness MWT · variables de entorno ────────────────────────────────
# Copia este archivo a .env y rellena los valores. NO subir .env al repo.

# Secreto para firmar la cookie de sesión del gateway (obligatorio).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Todos los secretos admiten la variante `<NOMBRE>_FILE`: si se define, el
# gateway lee el valor de ese archivo (Docker secret / bind mount) y tiene
# prioridad sobre la variable directa. Ejemplo en el VPS:
#   SESSION_SECRET_FILE=/run/secrets/session_secret
#   MWT_MCP_GATEWAY_KEY_FILE=/run/secrets/mwt_mcp_gateway_key
#   DEEPSEEK_API_KEY_FILE=/run/secrets/deepseek_api_key
# Con esto las claves dejan de estar en `.env` y en los archivos de parche por
# usuario (el parche las referencia como `!!js process.env.*`).

# API de la consola MWT.ONE (donde vive /api/auth/login/).
CONSOLA_API_BASE=https://consola.mwt.one/api

# Host público que ve el proxy (debe coincidir con el trusted-host de dsh).
PUBLIC_HOST=harness.mwt.one

# Cookie de sesión con el flag `Secure`. Activo por defecto (el gateway sirve
# por HTTPS tras mwt-nginx). Pon 0 solo para pruebas locales por HTTP.
COOKIE_SECURE=1

# Tiempo de vida de la sesión del gateway en ms (12 h por defecto).
SESSION_TTL_MS=43200000
# Tiempo máximo de arranque de un dsh hasta capturar su token (2 min).
DSH_READY_TIMEOUT_MS=120000

# Clave del modelo DeepSeek que usará el harness.
DEEPSEEK_API_KEY=

# ── MCP de la consola ─────────────────────────────────────────────────
MWT_MCP_URL=http://consola-mwt-one-mcp:8765/mcp
# Secreto compartido gateway→MCP (MWT_MCP_GATEWAY_KEY del stack consola).
MWT_MCP_GATEWAY_KEY=
# Opcional: cliente/tenant por defecto (UUID de clientes.cliente.id).
MWT_MCP_CLIENT_ID=
# E2 · fijar X-MWT-Client-ID con la empresa del usuario si tiene una sola (1 por defecto).
MWT_MCP_CLIENT_ID_FROM_USER=1

# ── Memoria de agente (TencentDB Agent Memory) ────────────────────────
# Con MEMORY_ENABLED=1 cada dsh enruta su modelo por el proxy de memoria y
# recibe la identidad de un usuario de memoria aprovisionado por email. El
# stack (memory-core + memory-hub + proxy) vive fuera de este compose, en
# /opt/tdai, y comparte la red external `tdai-memory-stack`.
MEMORY_ENABLED=0
MEMORY_CORE_URL=http://memory-core:8420
MEMORY_PROXY_URL=http://proxy:8096
# Clave de administración del core (deploy/global-images/.admin-key del stack).
# Sin ella la memoria se desactiva y el harness va directo a DeepSeek.
MEMORY_ADMIN_KEY=
MEMORY_SERVICE_ID=default
# Nombre del agente que se crea en el espacio de memoria de cada usuario.
MEMORY_AGENT_NAME=Asistente MWT
# Tiempo máximo por llamada al core de memoria (ms).
MEMORY_TIMEOUT_MS=10000
# Clave compartida gateway→proxy de memoria (cabecera del proxy local).
MEMORY_GATEWAY_KEY=local
# Máximo de recuerdos que el proxy inyecta por petición.
MEMORY_LIMIT=50
# Archivo de identidades de memoria por usuario (por defecto junto a DATA_DIR).
MEMORY_STATE_FILE=

# ── MCP de FaberLoom (espacios) ───────────────────────────────────────
# URL interna del MCP de FaberLoom y secreto compartido (X-Faberloom-Gateway-Key).
# Si ambos están, cada dsh arranca con el MCP "faberloom" además del de MWT.ONE.
FABERLOOM_MCP_URL=http://faberloom-mcp:8090/mcp
FABERLOOM_GATEWAY_KEY=

# ── context-mode (MCP de contexto) ────────────────────────────────────
# Servidor MCP stdio instalado en la imagen; cada dsh lo arranca con su
# DSH_HOME como proyecto y almacenamiento (SQLite/FTS5 por usuario).
# Licencia Elastic-2.0 (source-available): uso interno permitido.
CONTEXT_MODE_ENABLED=1
CONTEXT_MODE_ENTRY=/usr/local/lib/node_modules/context-mode/start.mjs
CONTEXT_MODE_TIMEOUT_MS=120000

# ── Despachador persistente de rutinas ────────────────────────────────────────
# Una pasada cada N ms por usuario: inicia rutinas con disparador de fecha o
# recurrencia, avanza ejecuciones y reconcilia efectos pendientes sin panel abierto.
DISPATCHER_INTERVAL_MS=60000

# ── Receptor de correo (IMAP del usuario) ─────────────────────────────────────
# Sondea el IMAP que cada usuario configura en Conexiones y convierte los
# mensajes nuevos en eventos de rutina. Requiere que el usuario tenga una
# conexión IMAP válida; con INBOUND_ENABLED=0 el receptor no arranca.
INBOUND_ENABLED=1
INBOUND_INTERVAL_MS=300000
INBOUND_MAILBOX=INBOX

# ── Plazo de las esperas de rutina ────────────────────────────────────────────
# Una espera sin respuesta pasa a revisión (WAIT_TIMEOUT) en vez de quedarse
# parada para siempre. Por defecto 24 h; bájalo para detectar antes una respuesta
# perdida, teniendo en cuenta que también caduca esperas legítimas largas.
WAIT_TIMEOUT_MS=86400000

# ── Runner de dsh ─────────────────────────────────────────────────────
DATA_DIR=/data/users
DSH_BASE_PORT=3100
# Entrypoint del harness customizado dentro de la imagen del gateway.
DSH_BIN=/opt/dsh/bin-dsh
# Perfil del harness que se arranca por usuario: `faberloom` monta los
# módulos nativos del producto sobre la superficie web.
DSH_PROFILE=faberloom

# Modo estático (solo pruebas locales): en vez de arrancar procesos hijos,
# el gateway reenvía a un dsh ya en marcha. Ambos vacíos en producción.
STATIC_DSH_PORT=
STATIC_DSH_TOKEN=

# Archivo de identidad mínima por usuario (para arrancar su dsh en llamadas MCP
# sin navegador). Por defecto, junto a DATA_DIR.
USER_STATE_FILE=
# Raíz del catálogo de skills del rol (`<rol>/<skill>/SKILL.md`).
SKILLS_CATALOG_ROOT=/opt/skills-catalog

# ── Límites por instancia dsh (E1) ────────────────────────────────────
# Cap de heap de Node por usuario (MB); evita que uno agote la RAM.
DSH_MAX_OLD_SPACE_MB=1024
# Descriptores de archivo por proceso.
DSH_NOFILE_LIMIT=8192
# Segundos de CPU por proceso; 0 = sin límite (recomendado para agentes largos).
DSH_CPU_LIMIT_S=0

# ── Índice de tokens MCP (M1) ─────────────────────────────────────────
# Índice token→propietario en /data (escrito con tmp+rename y permisos 0600).
# Resuelve /mcp en O(1) en vez de escanear el almacén de cada usuario; el
# gateway lo reconstruye desde los almacenes cuando caduca.
MCP_TOKEN_INDEX_FILE=
MCP_TOKEN_INDEX_REFRESH_MS=300000
# Máximo de peticiones /mcp por IP en una ventana deslizante de 60 s.
MCP_RATE_LIMIT_PER_MIN=120

# ── Intentos de login (M6) ────────────────────────────────────────────
# Máximo por cuenta y minuto; nginx ya limita por IP. El límite por IP del
# gateway se calcula como este valor ×4. El formulario de login usa además un
# token CSRF de doble envío (M7), que no requiere configuración.
LOGIN_RATE_LIMIT_PER_MIN=12

# ── Observabilidad (M4/M9) ────────────────────────────────────────────
# /metrics expone contadores Prometheus (logins, arranques/paradas de dsh,
# peticiones MCP, límites aplicados). /healthz amplía su respuesta con el
# despachador, el último backup, la identidad de build y el drift del manifiesto.
# SHA del fork construido (lo escribe el Dockerfile en la etapa de build).
DSH_FORK_SHA_FILE=/opt/dsh/.fork-sha
# Estado del último backup de /data: /healthz publica su mtime y su texto.
BACKUP_STATUS_FILE=/opt/mwt/harness_backup_status.txt
# Manifiesto del despliegue para el drift de /healthz. docker-compose.yml lo fija
# a /opt/mwt/harness-manifest/MANIFEST.md: un directorio montado en solo lectura
# que deploy-vps.sh rellena en cada despliegue (así el compara con el manifiesto
# desplegado, no con el cocido en la imagen). Vacío usa /app/MANIFEST.md.
MANIFEST_FILE=

# ── Límites del contenedor del gateway (M2) ───────────────────────────
# Deben cubrir varios dsh concurrentes (heap por proceso = DSH_MAX_OLD_SPACE_MB).
# memswap = mem desactiva swap; deja margen si el VPS aloja otros stacks.
GATEWAY_MEM_LIMIT=6g
GATEWAY_MEMSWAP_LIMIT=6g
GATEWAY_CPUS=2.0
GATEWAY_PIDS_LIMIT=2048
