{
  "name": "@deepseek-ai/dsh-faberloom-handlers",
  "description": "Native product routine step handlers (ctx.faberloomHandlers): the implementation behind each handler name a routine step declares, so a routine can activate and run",
  "version": "0.1.6-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/faberloom/handlers"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
