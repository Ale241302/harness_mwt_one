  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-faberloom-agents": "workspace:^",
    "@deepseek-ai/dsh-faberloom-routines": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
