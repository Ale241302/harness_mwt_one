{
  "name": "@deepseek-ai/dsh-faberloom-view",
  "description": "Read-only FaberLoom workspace view for the browser: one Remote read of the signed-in owner's spaces, agents, board, and routines",
  "version": "0.1.6-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/faberloom/view"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-faberloom-access": "workspace:^",
    "@deepseek-ai/dsh-faberloom-backup": "workspace:^",
    "@deepseek-ai/dsh-faberloom-learning": "workspace:^",
    "@deepseek-ai/dsh-faberloom-mcp-server": "workspace:^",
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-typert-protocol": "workspace:^",
    "@deepseek-ai/dsh-workspace": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-faberloom-access": "workspace:^",
    "@deepseek-ai/dsh-faberloom-backup": "workspace:^",
    "@deepseek-ai/dsh-faberloom-agents": "workspace:^",
    "@deepseek-ai/dsh-faberloom-board": "workspace:^",
    "@deepseek-ai/dsh-faberloom-connections": "workspace:^",
    "@deepseek-ai/dsh-faberloom-inbound": "workspace:^",
    "@deepseek-ai/dsh-faberloom-learning": "workspace:^",
    "@deepseek-ai/dsh-faberloom-mcp-server": "workspace:^",
    "@deepseek-ai/dsh-faberloom-routines": "workspace:^",
    "@deepseek-ai/dsh-faberloom-spaces": "workspace:^",
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-typert-protocol": "workspace:^",
    "@deepseek-ai/dsh-workspace": "workspace:^",
    "zod": "^4.4.3"
  }
}
